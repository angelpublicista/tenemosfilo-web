# Copia este archivo como .env.local y completa los valores reales.
# En Netlify van en Site settings > Environment variables.

# ==========================================
# API de Tenemos Filo
# ==========================================

# Produccion: https://api.tenemosfilo.com
# Local (levantando tenemosfilo-api): http://localhost:4000
TF_API_URL=https://api.tenemosfilo.com

# La API key de la empresa. Empieza por `tf_live_`.
#
# OJO: es una credencial de SERVIDOR. Quien la tenga puede reservar en nombre
# de la empresa, asi que no lleva el prefijo NEXT_PUBLIC_ y nunca debe
# llevarlo: todo lo que empieza por NEXT_PUBLIC_ se incrusta en el bundle del
# navegador y queda a la vista de cualquiera.
#
# Scopes que necesita el sitio:
#   experiences:read     listado, destacadas y ficha
#   availabilities:read  calendario de reservas
#   locations:read       sedes
#   quotes:write         formulario de experiencias para grupos
#
# El sitio NO necesita reservations:write: las reservas propias van por
# /reservations/public, que no lleva credencial.
#
# La key se muestra una sola vez al crearla. Si se pierde, hay que revocarla
# y emitir otra.
TF_API_KEY=

# ==========================================
# Sitio
# ==========================================

# URL canonica, para metadatos y sitemap.
NEXT_PUBLIC_SITE_URL=https://tenemosfilo.com

# El blog vive aparte, en WordPress. Solo lo enlazamos.
NEXT_PUBLIC_BLOG_URL=https://blog.tenemosfilo.com

# El panel de anfitriones (tenemos-filo-front). Ahi viven el registro y la
# gestion de experiencias; la landing de /anfitriones lleva el trafico alli.
NEXT_PUBLIC_PANEL_URL=https://app.tenemosfilo.com

# ==========================================
# Leads de grupos (n8n)
# ==========================================

# Webhook al que se manda cada solicitud del formulario /grupos.
# En n8n: nodo Webhook, método POST, y copia aquí su Production URL.
#
# Sustituye a `POST /quotes` del API, que guardaba los leads en una tabla sin
# avisar a nadie. Sin esta variable el formulario no envía: muestra un error y
# ofrece el correo de contacto, en vez de dar las gracias por un lead perdido.
N8N_WEBHOOK_URL=

# Secreto compartido. El sitio lo manda en la cabecera `X-Filo-Secret` y el
# flujo de n8n debe rechazar lo que no lo traiga; si no, cualquiera que
# descubra la URL puede inyectar leads falsos.
# Generar uno nuevo con: openssl rand -hex 24
N8N_WEBHOOK_SECRET=
